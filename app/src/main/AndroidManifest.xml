<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Notificaciones push (requerido en Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Permisos para mostrar badge en el ícono (ShortcutBadger) -->
    <uses-permission android:name="com.android.launcher.permission.READ_SETTINGS" />
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />
    <uses-permission android:name="com.android.launcher.permission.UNINSTALL_SHORTCUT" />

    <!-- Permisos específicos para diferentes launchers -->
    <!-- Samsung/TouchWiz -->
    <uses-permission android:name="com.sec.android.provider.badge.permission.READ" />
    <uses-permission android:name="com.sec.android.provider.badge.permission.WRITE" />
    <!-- HTC -->
    <uses-permission android:name="com.htc.launcher.permission.READ_SETTINGS" />
    <uses-permission android:name="com.htc.launcher.permission.UPDATE_SHORTCUT" />
    <!-- Sony -->
    <uses-permission android:name="com.sonyericsson.home.permission.BROADCAST_BADGE" />
    <uses-permission android:name="com.sonymobile.home.permission.PROVIDER_INSERT_BADGE" />
    <!-- Apex -->
    <uses-permission android:name="com.anddoes.launcher.permission.UPDATE_COUNT" />
    <!-- Solid -->
    <uses-permission android:name="com.majeur.launcher.permission.UPDATE_BADGE" />
    <!-- Huawei -->
    <uses-permission android:name="com.huawei.android.launcher.permission.CHANGE_BADGE" />
    <uses-permission android:name="com.huawei.android.launcher.permission.READ_SETTINGS" />
    <uses-permission android:name="com.huawei.android.launcher.permission.WRITE_SETTINGS" />
    <!-- ZUK -->
    <uses-permission android:name="android.permission.READ_APP_BADGE" />
    <!-- OPPO -->
    <uses-permission android:name="com.oppo.launcher.permission.READ_SETTINGS" />
    <uses-permission android:name="com.oppo.launcher.permission.WRITE_SETTINGS" />
    <!-- EvMe -->
    <uses-permission android:name="me.everything.badger.permission.BADGE_COUNT_READ" />
    <uses-permission android:name="me.everything.badger.permission.BADGE_COUNT_WRITE" />

    <application
        android:name=".GimnasioproApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GimnasioPro">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.GimnasioPro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GimActivity"
            android:exported="false"
            android:label="@string/btn_gim"
            android:theme="@style/Theme.GimnasioPro" />

        <activity
            android:name=".EjerciciosActivity"
            android:exported="false"
            android:label="@string/btn_ejercicios"
            android:theme="@style/Theme.GimnasioPro" />

        <activity
            android:name=".ListaEjerciciosActivity"
            android:exported="false"
            android:label="@string/titulo_ejercicios"
            android:theme="@style/Theme.GimnasioPro" />

        <activity
            android:name=".RutinasActivity"
            android:exported="false"
            android:label="@string/btn_rutinas"
            android:theme="@style/Theme.GimnasioPro" />

        <activity
            android:name=".DetalleRutinaActivity"
            android:exported="false"
            android:label="@string/titulo_detalle_rutina"
            android:theme="@style/Theme.GimnasioPro" />

        <activity
            android:name=".ProgresoActivity"
            android:exported="false"
            android:label="@string/btn_progreso"
            android:theme="@style/Theme.GimnasioPro" />

        <activity
            android:name=".PersonalTrainerActivity"
            android:exported="false"
            android:label="@string/btn_personal_trainer"
            android:theme="@style/Theme.GimnasioPro" />

        <activity
            android:name=".EntrenamientoActivity"
            android:exported="false"
            android:label="@string/titulo_entrenamiento"
            android:theme="@style/Theme.GimnasioPro" />
        <activity
            android:name=".presentation.trainer.RegisterTrainerActivity"
            android:exported="false"
            android:label="Registro de Entrenador"
            android:theme="@style/Theme.GimnasioPro" />
        <activity
            android:name=".presentation.auth.VerificarEmailActivity"
            android:exported="false"
            />
        <activity
            android:name=".presentation.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- Registro Cliente -->
        <activity
            android:name=".presentation.cliente.RegisterClienteActivity"
            android:exported="false" />

        <!-- Perfil de usuario -->
        <activity
            android:name=".PerfilActivity"
            android:exported="false"
            android:label="Mi Perfil"
            android:theme="@style/Theme.GimnasioPro" />

        <!-- Búsqueda de ejercicios -->
        <activity
            android:name=".BuscarEjerciciosActivity"
            android:exported="false"
            android:label="@string/titulo_buscar_ejercicios"
            android:theme="@style/Theme.GimnasioPro"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!-- Buscar Trainer (para clientes) -->
        <activity
            android:name=".BuscarTrainerActivity"
            android:exported="false"
            android:label="Buscar Trainer"
            android:theme="@style/Theme.GimnasioPro" />

        <!-- Lista de Clientes (para trainers) -->
        <activity
            android:name=".ListaClientesActivity"
            android:exported="false"
            android:label="Mis Clientes"
            android:theme="@style/Theme.GimnasioPro" />

        <!-- Contacta Activity -->
        <activity
            android:name=".ContactaActivity"
            android:exported="false"
            android:label="Contacta"
            android:theme="@style/Theme.GimnasioPro" />

        <!-- Conversacion Activity -->
        <activity
            android:name=".ConversacionActivity"
            android:exported="false"
            android:label="Conversación"
            android:theme="@style/Theme.GimnasioPro"
            android:windowSoftInputMode="adjustResize" />

        <!-- Notificaciones Activity -->
        <activity
            android:name=".NotificacionesActivity"
            android:exported="false"
            android:label="Notificaciones"
            android:theme="@style/Theme.GimnasioPro" />

        <!-- ====== FIREBASE MESSAGING SERVICE (NUEVO) ====== -->
        <service
            android:name=".presentation.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-2121593613571802~1957466227"/>


    </application>

</manifest>