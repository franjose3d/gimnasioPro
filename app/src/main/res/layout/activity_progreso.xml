<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".ProgresoActivity">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:paddingTop="32dp"
        android:background="@color/darker_green_header">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/btn_volver"
            android:scaleType="centerInside"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvTituloProgreso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/titulo_progreso"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/accent_blue" />
    </LinearLayout>

    <!-- Contenido principal -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Sección de estadísticas generales -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/estadisticas_generales"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/accent_blue"
                android:layout_marginBottom="16dp" />

            <!-- Fila 1: Tiempo Hoy + Tiempo Mes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:baselineAligned="false">

                <!-- Card de tiempo de entrenamiento HOY -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    xmlns:app="http://schemas.android.com/apk/res-auto">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tiempo_entrenamiento_hoy"
                            android:textSize="12sp"
                            android:textColor="@color/text_light_gray"
                            android:maxLines="2" />

                        <TextView
                            android:id="@+id/tvTiempoHoy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tiempo_inicial"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_blue"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card de tiempo total del MES -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    xmlns:app="http://schemas.android.com/apk/res-auto">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tiempo_entrenamiento_mes"
                            android:textSize="12sp"
                            android:textColor="@color/text_light_gray"
                            android:maxLines="2" />

                        <TextView
                            android:id="@+id/tvTiempoMes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tiempo_inicial"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_blue"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Fila 2: Entrenamientos Mes + Racha Actual -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:baselineAligned="false">

                <!-- Card de entrenamientos del mes -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    xmlns:app="http://schemas.android.com/apk/res-auto">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/entrenamientos_mes"
                            android:textSize="12sp"
                            android:textColor="@color/text_light_gray"
                            android:maxLines="2" />

                        <TextView
                            android:id="@+id/tvEntrenamientosMes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/valor_cero_entero"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_blue"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card de racha actual -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    xmlns:app="http://schemas.android.com/apk/res-auto">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/racha_actual"
                            android:textSize="12sp"
                            android:textColor="@color/text_light_gray"
                            android:maxLines="2" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp">

                            <TextView
                                android:id="@+id/tvRachaActual"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/valor_cero_entero"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/orange_accent" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dias"
                                android:textSize="14sp"
                                android:textColor="@color/text_light_gray"
                                android:layout_marginStart="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Sección de Peso Total Movido -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/peso_total_movido"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/accent_blue"
                android:layout_marginBottom="16dp" />

            <!-- Fila: Peso Hoy + Récord Personal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:baselineAligned="false">

                <!-- Card de peso movido hoy -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    xmlns:app="http://schemas.android.com/apk/res-auto">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/peso_movido_hoy"
                            android:textSize="12sp"
                            android:textColor="@color/text_light_gray"
                            android:maxLines="2" />

                        <TextView
                            android:id="@+id/tvPesoMovidoHoy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/valor_cero_kg"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_blue"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card de récord personal -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@color/card_background"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    xmlns:app="http://schemas.android.com/apk/res-auto">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/record_peso_movido"
                            android:textSize="12sp"
                            android:textColor="@color/text_light_gray"
                            android:maxLines="2" />

                        <TextView
                            android:id="@+id/tvRecordPesoMovido"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/valor_cero_kg"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/orange_accent"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Sección de Equilibrio Muscular -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/equilibrio_muscular"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/accent_blue"
                android:layout_marginBottom="16dp" />

            <!-- Card de barras de progreso muscular -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Pectorales -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/grupo_pectorales"
                                android:textSize="14sp"
                                android:textColor="@color/text_on_background" />

                            <TextView
                                android:id="@+id/tvPorcentajePectorales"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/porcentaje_cero"
                                android:textSize="12sp"
                                android:textColor="@color/text_light_gray" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progressPectorales"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="4dp"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/progress_bar_pectorales" />
                    </LinearLayout>

                    <!-- Espalda -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/grupo_espalda"
                                android:textSize="14sp"
                                android:textColor="@color/text_on_background" />

                            <TextView
                                android:id="@+id/tvPorcentajeEspalda"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/porcentaje_cero"
                                android:textSize="12sp"
                                android:textColor="@color/text_light_gray" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progressEspalda"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="4dp"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/progress_bar_espalda" />
                    </LinearLayout>

                    <!-- Hombros -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/grupo_hombros"
                                android:textSize="14sp"
                                android:textColor="@color/text_on_background" />

                            <TextView
                                android:id="@+id/tvPorcentajeHombros"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/porcentaje_cero"
                                android:textSize="12sp"
                                android:textColor="@color/text_light_gray" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progressHombros"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="4dp"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/progress_bar_hombros" />
                    </LinearLayout>

                    <!-- Bíceps y Antebrazo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/grupo_biceps"
                                android:textSize="14sp"
                                android:textColor="@color/text_on_background" />

                            <TextView
                                android:id="@+id/tvPorcentajeBiceps"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/porcentaje_cero"
                                android:textSize="12sp"
                                android:textColor="@color/text_light_gray" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progressBiceps"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="4dp"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/progress_bar_biceps" />
                    </LinearLayout>

                    <!-- Tríceps -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/grupo_triceps"
                                android:textSize="14sp"
                                android:textColor="@color/text_on_background" />

                            <TextView
                                android:id="@+id/tvPorcentajeTriceps"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/porcentaje_cero"
                                android:textSize="12sp"
                                android:textColor="@color/text_light_gray" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progressTriceps"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="4dp"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/progress_bar_triceps" />
                    </LinearLayout>

                    <!-- Abdominales -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/grupo_abdominales"
                                android:textSize="14sp"
                                android:textColor="@color/text_on_background" />

                            <TextView
                                android:id="@+id/tvPorcentajeAbdominales"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/porcentaje_cero"
                                android:textSize="12sp"
                                android:textColor="@color/text_light_gray" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progressAbdominales"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="4dp"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/progress_bar_abdominales" />
                    </LinearLayout>

                    <!-- Piernas -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/grupo_piernas"
                                android:textSize="14sp"
                                android:textColor="@color/text_on_background" />

                            <TextView
                                android:id="@+id/tvPorcentajePiernas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/porcentaje_cero"
                                android:textSize="12sp"
                                android:textColor="@color/text_light_gray" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progressPiernas"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="4dp"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/progress_bar_piernas" />
                    </LinearLayout>

                    <!-- Glúteos -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/grupo_gluteos"
                                android:textSize="14sp"
                                android:textColor="@color/text_on_background" />

                            <TextView
                                android:id="@+id/tvPorcentajeGluteos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/porcentaje_cero"
                                android:textSize="12sp"
                                android:textColor="@color/text_light_gray" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progressGluteos"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="4dp"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/progress_bar_gluteos" />
                    </LinearLayout>

                    <!-- Gemelos -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/grupo_gemelos"
                                android:textSize="14sp"
                                android:textColor="@color/text_on_background" />

                            <TextView
                                android:id="@+id/tvPorcentajeGemelos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/porcentaje_cero"
                                android:textSize="12sp"
                                android:textColor="@color/text_light_gray" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progressGemelos"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="4dp"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/progress_bar_gemelos" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>


        </LinearLayout>
    </ScrollView>

</LinearLayout>

