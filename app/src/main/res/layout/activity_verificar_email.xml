<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- Icono grande -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📧"
            android:textSize="80sp"
            android:layout_marginBottom="24dp" />

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verifica tu email"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/accent_blue"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Mensaje principal -->
        <TextView
            android:id="@+id/tvMensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hemos enviado un email de verificación a:"
            android:textSize="16sp"
            android:textColor="@color/text_light_gray"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Email -->
        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ejemplo@gmail.com"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/accent_blue"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- Instrucciones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_trainer"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📝 Pasos a seguir:"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1️⃣ Abre tu correo electrónico"
                android:textSize="14sp"
                android:textColor="#000000"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2️⃣ Busca el email de Firebase / GimnasioPro"
                android:textSize="14sp"
                android:textColor="#000000"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3️⃣ Haz click en el enlace de verificación"
                android:textSize="14sp"
                android:textColor="#000000"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4️⃣ Vuelve aquí y presiona CONTINUAR"
                android:textSize="14sp"
                android:textColor="#000000" />
        </LinearLayout>

        <!-- Estado actual -->
        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏳ Esperando verificación..."
            android:textSize="14sp"
            android:textColor="@color/text_light_gray"
            android:textStyle="italic"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Botón Reenviar Email -->
        <Button
            android:id="@+id/btnReenviar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="📧 REENVIAR EMAIL"
            android:textColor="@color/text_on_button"
            android:textStyle="bold"
            android:textSize="16sp"
            android:background="@drawable/bg_card_trainer"
            android:elevation="8dp"
            android:stateListAnimator="@null"
            android:layout_marginBottom="12dp" />

        <!-- Botón Continuar -->
        <Button
            android:id="@+id/btnContinuar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="YA VERIFIQUÉ - CONTINUAR"
            android:textColor="@color/text_on_button"
            android:textStyle="bold"
            android:textSize="16sp"
            android:background="@drawable/bg_card_trainer"
            android:elevation="8dp"
            android:stateListAnimator="@null"
            android:layout_marginBottom="12dp" />

        <!-- Botón Cerrar Sesión -->
        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cerrar sesión"
            android:textColor="@color/text_light_gray"
            android:textSize="14sp"
            android:background="@android:color/transparent"
            android:textAllCaps="false" />

        <!-- Notas -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 Consejo: Revisa también la carpeta de spam"
            android:textSize="12sp"
            android:textColor="@color/text_light_gray"
            android:textStyle="italic"
            android:gravity="center"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>