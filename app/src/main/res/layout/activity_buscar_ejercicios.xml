<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".BuscarEjerciciosActivity">

    <!-- Header con SearchView -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:paddingTop="32dp"
        android:background="@color/darker_green_header">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/btn_volver"
            android:scaleType="centerInside"
            android:clickable="true"
            android:focusable="true" />

        <!-- Campo de búsqueda -->
        <EditText
            android:id="@+id/etBuscar"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_search_field"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp"
            android:hint="@string/hint_buscar_ejercicio"
            android:inputType="text"
            android:maxLines="1"
            android:imeOptions="actionSearch"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/white"
            android:textColorHint="@color/hint_text"
            android:textSize="16sp"
            app:drawableTint="@color/hint_text" />
    </LinearLayout>

    <!-- Mensaje cuando no hay resultados -->
    <TextView
        android:id="@+id/tvNoResultados"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/sin_resultados_busqueda"
        android:textColor="@color/hint_text"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Indicador de escribir para buscar -->
    <TextView
        android:id="@+id/tvEscribeParaBuscar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="Escribe para buscar ejercicios"
        android:textColor="@color/hint_text"
        android:textSize="16sp"
        android:visibility="visible" />

    <!-- Lista de resultados -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvResultados"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp" />

    <!-- Panel de selección (si viene de una rutina) -->
    <LinearLayout
        android:id="@+id/layoutSeleccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp"
        android:background="@color/darker_green_header"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvContadorSeleccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginEnd="16dp" />

        <Button
            android:id="@+id/btnCancelarSeleccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_cancelar"
            android:textSize="12sp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <Button
            android:id="@+id/btnGuardarSeleccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/btn_guardar"
            android:textSize="12sp"
            style="@style/Widget.MaterialComponents.Button" />
    </LinearLayout>

</LinearLayout>

