<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_green_background"
    android:fitsSystemWindows="true"
    tools:context=".PersonalTrainerActivity">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:paddingTop="32dp"
        android:background="@color/darker_green_header">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Volver"
            android:scaleType="centerInside"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Tu Registro"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/accent_blue" />
    </LinearLayout>

    <!-- Contenido principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">



        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gestiona tu entrenamiento"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/accent_blue"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Descripción -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Encuentra entrenadores profesionales o regístrate para ofrecer tus servicios"
            android:textSize="16sp"
            android:textColor="@color/text_light_gray"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="48dp" />

        <!-- BOTÓN 0: INICIAR SESIÓN (NUEVO) -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="INICIAR SESION"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_button"
            android:background="@drawable/bg_card_trainer"
            android:elevation="8dp"
            android:stateListAnimator="@null"
            android:layout_marginBottom="24dp" />

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/accent_blue"
            android:alpha="0.3"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Eres nuevo?"
            android:textSize="14sp"
            android:textColor="@color/text_light_gray"
            android:gravity="center"
            android:layout_marginBottom="16dp" />


        <!-- BOTÓN 2: REGISTRARSE COMO USUARIO/CLIENTE -->
        <Button
            android:id="@+id/btnRegistrarseUsuario"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="REGISTRARSE COMO CLIENTE"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_button"
            android:background="@drawable/bg_card_trainer"
            android:elevation="8dp"
            android:stateListAnimator="@null"
            android:layout_marginBottom="16dp" />

        <!-- BOTÓN 3: REGISTRARSE COMO ENTRENADOR -->
        <Button
            android:id="@+id/btnRegistrarseTrainer"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="REGISTRARSE COMO ENTRENADOR"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_button"
            android:background="@drawable/bg_card_trainer"
            android:elevation="8dp"
            android:stateListAnimator="@null"
            android:layout_marginBottom="24dp" />

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/accent_blue"
            android:alpha="0.3"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- Info adicional -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Entrenadores verificados\nRutinas personalizadas\nSeguimiento de progreso"
            android:textSize="14sp"
            android:textColor="@color/text_light_gray"
            android:gravity="center"
            android:lineSpacingMultiplier="1.5" />

    </LinearLayout>

</LinearLayout>