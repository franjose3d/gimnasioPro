<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Campo Nombre -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre del ejercicio"
        android:textSize="14sp"
        android:textColor="#000000"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etNombreEjercicio"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Ej: Flexiones diamante"
        android:textColor="#000000"
        android:textColorHint="#808080"
        android:background="@drawable/btn_rounded_green"
        android:padding="12dp"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:layout_marginBottom="16dp" />

    <!-- Campo Descripción -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Descripción (máximo 200 caracteres)"
        android:textSize="14sp"
        android:textColor="#000000"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etDescripcionEjercicio"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:hint="Describe brevemente cómo realizar el ejercicio..."
        android:textColor="#000000"
        android:textColorHint="#808080"
        android:background="@drawable/btn_rounded_green"
        android:padding="12dp"
        android:gravity="top|start"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLength="200"
        android:scrollbars="vertical" />

</LinearLayout>