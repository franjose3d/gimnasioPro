<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_green_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- Logo o icono -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@android:drawable/ic_lock_idle_lock"
            android:contentDescription="Login"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp"
            app:tint="@color/accent_blue" />

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iniciar Sesion"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/accent_blue"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bienvenido de nuevo"
            android:textSize="16sp"
            android:textColor="@color/text_light_gray"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- Email -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textSize="14sp"
            android:textColor="@color/accent_blue"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="ejemplo@gmail.com"
            android:textColor="#000000"
            android:textColorHint="#808080"
            android:background="@drawable/bg_card_trainer"
            android:padding="16dp"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:layout_marginBottom="16dp" />

        <!-- Contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contraseña"
            android:textSize="14sp"
            android:textColor="@color/accent_blue"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Tu contraseña"
            android:textColor="#000000"
            android:textColorHint="#808080"
            android:background="@drawable/bg_card_trainer"
            android:padding="16dp"
            android:inputType="textPassword"
            android:maxLines="1"
            android:layout_marginBottom="8dp" />

        <!-- Recuperar contraseña -->
        <TextView
            android:id="@+id/btnRecuperarPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Olvidaste tu contraseña?"
            android:textSize="14sp"
            android:textColor="@color/accent_blue"
            android:textStyle="bold"
            android:layout_gravity="end"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="24dp" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Botón Login -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="INICIAR SESION"
            android:textColor="@color/text_on_button"
            android:textStyle="bold"
            android:textSize="16sp"
            android:background="@drawable/bg_card_trainer"
            android:elevation="8dp"
            android:stateListAnimator="@null"
            android:layout_marginBottom="24dp" />

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/accent_blue"
            android:alpha="0.3"
            android:layout_marginBottom="24dp" />

        <!-- Registrarse -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No tienes cuenta? "
                android:textSize="14sp"
                android:textColor="@color/text_light_gray" />

            <TextView
                android:id="@+id/btnRegistrarse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registrate"
                android:textSize="14sp"
                android:textColor="@color/accent_blue"
                android:textStyle="bold"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Notas -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Al iniciar sesion aceptas nuestros terminos y condiciones"
            android:textSize="11sp"
            android:textColor="@color/text_light_gray"
            android:textStyle="italic"
            android:gravity="center"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>