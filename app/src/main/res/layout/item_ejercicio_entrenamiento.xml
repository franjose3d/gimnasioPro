                    android:inputType="numberDecimal"
                    android:text="@string/valor_cero"
                    android:autofillHints="none"
                    android:textColor="@color/text_on_background"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="kg."
                    android:textColor="@color/accent_blue"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnIncrementarKg6"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_plus"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/desc_incrementar" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:background="@color/divider_color"
                    android:layout_marginStart="1dp"
                    android:layout_marginEnd="1dp" />

                <TextView
                    android:id="@+id/tvNumeroSerie6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6."
                    android:textColor="@color/accent_blue"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnQuitarSerie6"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_minus"
                    android:scaleType="centerInside"
                    android:visibility="gone"
                    app:tint="@color/accent_blue"
                    android:contentDescription="@string/desc_quitar_serie" />

            </LinearLayout>

        </LinearLayout>

        <!-- Botón único para añadir serie: azul, pegado al inicio, desaparece al llegar a 6 -->
        <ImageButton
            android:id="@+id/btnAgregarSerie"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="start"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card_trainer"
            android:src="@drawable/ic_plus"
            android:scaleType="centerInside"
            android:padding="6dp"
            app:tint="@color/white"
            android:contentDescription="@string/desc_agregar_serie" />

    </LinearLayout>

</androidx.cardview.widget.CardView>