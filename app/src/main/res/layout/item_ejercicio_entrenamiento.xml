<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Cabecera: Checkbox + Nombre del ejercicio -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <CheckBox
                android:id="@+id/checkboxCompletado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:buttonTint="@color/electric_green_button" />

            <TextView
                android:id="@+id/tvNombreEjercicio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/nombre_ejercicio_placeholder"
                android:textColor="@color/electric_green_button"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Contenedor de Series (filas dinámicas) -->
        <LinearLayout
            android:id="@+id/containerSeries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Fila 1: Series 1, 2, 3 + botones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <!-- Serie 1 -->
                <LinearLayout
                    android:id="@+id/containerSerie1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_input_field"
                    android:padding="6dp"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_rep1_kg"
                        android:textColor="@color/light_text"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <ImageButton
                            android:id="@+id/btnDecrementarKg1"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_minus"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/desc_decrementar" />

                        <EditText
                            android:id="@+id/etPeso1"
                            android:layout_width="40dp"
                            android:layout_height="30dp"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:inputType="numberDecimal"
                            android:text="@string/valor_cero"
                            android:autofillHints="none"
                            android:textColor="@color/text_on_background"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnIncrementarKg1"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_plus"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/desc_incrementar" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Serie 2 -->
                <LinearLayout
                    android:id="@+id/containerSerie2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_input_field"
                    android:padding="6dp"
                    android:layout_marginHorizontal="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_rep2_kg"
                        android:textColor="@color/light_text"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <ImageButton
                            android:id="@+id/btnDecrementarKg2"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_minus"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/desc_decrementar" />

                        <EditText
                            android:id="@+id/etPeso2"
                            android:layout_width="40dp"
                            android:layout_height="30dp"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:inputType="numberDecimal"
                            android:text="@string/valor_cero"
                            android:autofillHints="none"
                            android:textColor="@color/text_on_background"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnIncrementarKg2"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_plus"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/desc_incrementar" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Serie 3 -->
                <LinearLayout
                    android:id="@+id/containerSerie3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_input_field"
                    android:padding="6dp"
                    android:layout_marginStart="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_rep3_kg"
                        android:textColor="@color/light_text"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <ImageButton
                            android:id="@+id/btnDecrementarKg3"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_minus"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/desc_decrementar" />

                        <EditText
                            android:id="@+id/etPeso3"
                            android:layout_width="40dp"
                            android:layout_height="30dp"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:inputType="numberDecimal"
                            android:text="@string/valor_cero"
                            android:autofillHints="none"
                            android:textColor="@color/text_on_background"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnIncrementarKg3"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_plus"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/desc_incrementar" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Botones + / - para añadir/quitar series -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="8dp">

                    <ImageButton
                        android:id="@+id/btnAgregarSerie"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/btn_rounded_green"
                        android:src="@drawable/ic_plus"
                        android:scaleType="centerInside"
                        android:padding="4dp"
                        android:contentDescription="@string/desc_agregar_serie" />

                    <ImageButton
                        android:id="@+id/btnQuitarSerie"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/btn_rounded_red"
                        android:src="@drawable/ic_minus"
                        android:scaleType="centerInside"
                        android:padding="4dp"
                        android:contentDescription="@string/desc_quitar_serie" />
                </LinearLayout>

            </LinearLayout>

            <!-- Fila 2: Series adicionales (4, 5, 6) - inicialmente oculta -->
            <LinearLayout
                android:id="@+id/containerSeriesExtra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <!-- Serie 4 -->
                <LinearLayout
                    android:id="@+id/containerSerie4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_input_field"
                    android:padding="6dp"
                    android:layout_marginEnd="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_rep4_kg"
                        android:textColor="@color/light_text"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <ImageButton
                            android:id="@+id/btnDecrementarKg4"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_minus"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/desc_decrementar" />

                        <EditText
                            android:id="@+id/etPeso4"
                            android:layout_width="40dp"
                            android:layout_height="30dp"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:inputType="numberDecimal"
                            android:text="@string/valor_cero"
                            android:autofillHints="none"
                            android:textColor="@color/text_on_background"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnIncrementarKg4"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_plus"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/desc_incrementar" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Serie 5 -->
                <LinearLayout
                    android:id="@+id/containerSerie5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_input_field"
                    android:padding="6dp"
                    android:layout_marginHorizontal="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_rep5_kg"
                        android:textColor="@color/light_text"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <ImageButton
                            android:id="@+id/btnDecrementarKg5"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_minus"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/desc_decrementar" />

                        <EditText
                            android:id="@+id/etPeso5"
                            android:layout_width="40dp"
                            android:layout_height="30dp"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:inputType="numberDecimal"
                            android:text="@string/valor_cero"
                            android:autofillHints="none"
                            android:textColor="@color/text_on_background"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnIncrementarKg5"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_plus"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/desc_incrementar" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Serie 6 -->
                <LinearLayout
                    android:id="@+id/containerSerie6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_input_field"
                    android:padding="6dp"
                    android:layout_marginStart="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_rep6_kg"
                        android:textColor="@color/light_text"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <ImageButton
                            android:id="@+id/btnDecrementarKg6"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_minus"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/desc_decrementar" />

                        <EditText
                            android:id="@+id/etPeso6"
                            android:layout_width="40dp"
                            android:layout_height="30dp"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:inputType="numberDecimal"
                            android:text="@string/valor_cero"
                            android:autofillHints="none"
                            android:textColor="@color/text_on_background"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnIncrementarKg6"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_plus"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/desc_incrementar" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Espacio para alinear con los botones +/- -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>