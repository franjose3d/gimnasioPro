                    android:background="@drawable/btn_rounded_green"
                    android:elevation="8dp"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <!-- Botones Incrementar/Decrementar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp">

                <Button
                    android:id="@+id/btnDecrementarRutinas"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:text="-"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_on_button"
                    android:background="@drawable/bg_card_trainer"
                    android:elevation="8dp"
                    android:stateListAnimator="@null" />

                <TextView
                    android:id="@+id/tvContadorRutinas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:text="10"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_blue" />

                <Button
                    android:id="@+id/btnIncrementarRutinas"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:text="+"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_on_button"
                    android:background="@drawable/bg_card_trainer"
