<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_green_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registro Personal Trainer"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/accent_blue"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AUTENTICACION"
            android:textSize="16sp"
            android:textColor="@color/accent_blue"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textSize="14sp"
            android:textColor="@color/accent_blue"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="ejemplo@gmail.com"
            android:textColor="#000000"
            android:textColorHint="#808080"
            android:background="@drawable/bg_card_trainer"
            android:padding="12dp"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contraseña"
            android:textSize="14sp"
            android:textColor="@color/accent_blue"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Minimo 6 caracteres"
            android:textColor="#000000"
            android:textColorHint="#808080"
            android:background="@drawable/bg_card_trainer"
            android:padding="12dp"
            android:inputType="textPassword"
            android:maxLines="1"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirmar contraseña"
            android:textSize="14sp"
            android:textColor="@color/accent_blue"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etpasswordConfirm"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Repite la contraseña"
            android:textColor="#000000"
            android:textColorHint="#808080"
            android:background="@drawable/bg_card_trainer"
            android:padding="12dp"
            android:inputType="textPassword"
            android:maxLines="1"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DATOS PERSONALES"
            android:textSize="16sp"
            android:textColor="@color/accent_blue"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre y apellidos"
            android:textSize="14sp"
            android:textColor="@color/accent_blue"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etnombre"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Ej: Francisco Jose Garcia"
            android:textColor="#000000"
            android:textColorHint="#808080"
            android:background="@drawable/bg_card_trainer"
            android:padding="12dp"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DNI / NIE"
            android:textSize="14sp"
            android:textColor="@color/accent_blue"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etDNI"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Ej: 12345678A"
            android:textColor="#000000"
            android:textColorHint="#808080"
            android:background="@drawable/bg_card_trainer"
            android:padding="12dp"
            android:inputType="textCapCharacters"
            android:maxLength="9"
            android:maxLines="1"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ubicacion"
            android:textSize="14sp"
            android:textColor="@color/accent_blue"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etpoblacion"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Poblacion"
            android:textColor="#000000"
            android:textColorHint="#808080"
            android:background="@drawable/bg_card_trainer"
            android:padding="12dp"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etmunicipio"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Municipio"
            android:textColor="#000000"
            android:textColorHint="#808080"
            android:background="@drawable/bg_card_trainer"
            android:padding="12dp"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Telefono de contacto"
            android:textSize="14sp"
            android:textColor="@color/accent_blue"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_trainer"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+34"
                android:textSize="16sp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:paddingEnd="8dp" />

            <EditText
                android:id="@+id/ettelefono"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="612345678"
                android:textColor="#000000"
                android:textColorHint="#808080"
                android:background="@null"
                android:inputType="phone"
                android:maxLength="9"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sobre mi (opcional)"
            android:textSize="14sp"
            android:textColor="@color/text_light_gray"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etsobreMi"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Cuentanos sobre tu experiencia como entrenador..."
            android:textColor="#000000"
            android:textColorHint="#808080"
            android:background="@drawable/bg_card_trainer"
            android:padding="12dp"
            android:gravity="top|start"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="300"
            android:scrollbars="vertical"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fotografia de perfil (opcional)"
            android:textSize="14sp"
            android:textColor="@color/text_light_gray"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/ivfotoPerfil"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_card_trainer"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"
                android:contentDescription="Foto de perfil" />

            <Button
                android:id="@+id/btnseleccionarFoto"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="Seleccionar foto"
                android:textColor="@color/text_on_button"
                android:background="@drawable/bg_card_trainer"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tarifa por sesion (opcional)"
            android:textSize="14sp"
            android:textColor="@color/text_light_gray"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <EditText
                android:id="@+id/ettarifa"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:hint="Precio"
                android:textColor="#000000"
                android:textColorHint="#808080"
                android:background="@drawable/bg_card_trainer"
                android:padding="12dp"
                android:inputType="numberDecimal"
                android:maxLines="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EUR / sesion"
                android:textSize="16sp"
                android:textColor="@color/text_light_gray"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- SECCIÓN CERTIFICADO DE ENTRENADOR -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Certificado de entrenador"
            android:textSize="14sp"
            android:textColor="@color/accent_blue"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sube tu certificado o titulación de entrenador personal (PDF o imagen)"
            android:textSize="12sp"
            android:textColor="@color/text_light_gray"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/ivCertificadoIcon"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_card_trainer"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_upload"
                android:contentDescription="Certificado" />

            <Button
                android:id="@+id/btnSeleccionarCertificado"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="Seleccionar certificado"
                android:textColor="@color/text_on_button"
                android:background="@drawable/bg_card_trainer"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCertificadoNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ningún archivo seleccionado"
            android:textSize="12sp"
            android:textColor="@color/text_light_gray"
            android:textStyle="italic"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Campos obligatorios marcados con negrita"
            android:textSize="12sp"
            android:textColor="@color/text_light_gray"
            android:textStyle="italic"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recibiras un email para verificar tu cuenta"
            android:textSize="11sp"
            android:textColor="@color/text_light_gray"
            android:textStyle="italic"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solo se puede registrar 1 entrenador por DNI y telefono"
            android:textSize="11sp"
            android:textColor="@color/text_light_gray"
            android:textStyle="italic"
            android:layout_marginBottom="16dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- ====== NUEVO: Términos y Condiciones ====== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <CheckBox
                android:id="@+id/checkboxTerminos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/accent_color" />

            <TextView
                android:id="@+id/tvTerminos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Acepto los Términos y Condiciones y Política de Privacidad"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <Button
            android:id="@+id/btnregistrar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="CREAR CUENTA Y REGISTRARSE"
            android:textColor="@color/text_on_button"
            android:textStyle="bold"
            android:textSize="16sp"
            android:background="@drawable/bg_card_trainer"
            android:elevation="8dp"
            android:stateListAnimator="@null" />

    </LinearLayout>

</ScrollView>